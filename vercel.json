{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pieces/tanguy-nianzou-nz-ring",
      "destination": "/players/tanguy-nianzou",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/tanguy-nianzou-nz-ring",
      "destination": "/:lang/players/tanguy-nianzou",
      "statusCode": 301
    },
    {
      "source": "/pieces/marcus-thuram-signet-ring",
      "destination": "/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/marcus-thuram-signet-ring",
      "destination": "/:lang/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/pieces/marcus-thuram-t-monster-pendant",
      "destination": "/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/marcus-thuram-t-monster-pendant",
      "destination": "/:lang/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/pieces/marcus-thuram-jesus-piece",
      "destination": "/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/marcus-thuram-jesus-piece",
      "destination": "/:lang/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/pieces/marcus-thuram-snowflake-pendant",
      "destination": "/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/marcus-thuram-snowflake-pendant",
      "destination": "/:lang/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/pieces/tanguy-nianzou-nz-pendant",
      "destination": "/players/tanguy-nianzou",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/tanguy-nianzou-nz-pendant",
      "destination": "/:lang/players/tanguy-nianzou",
      "statusCode": 301
    },
    {
      "source": "/pieces/sidney-eweka-999-pendant",
      "destination": "/creations",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/sidney-eweka-999-pendant",
      "destination": "/:lang/creations",
      "statusCode": 301
    },
    {
      "source": "/pieces/jeff-chabot-jc-pendant",
      "destination": "/creations",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/jeff-chabot-jc-pendant",
      "destination": "/:lang/creations",
      "statusCode": 301
    },
    {
      "source": "/pieces/jack-nameplate-pendant",
      "destination": "/creations",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/jack-nameplate-pendant",
      "destination": "/:lang/creations",
      "statusCode": 301
    },
    {
      "source": "/pieces/marcus-thuram-infinity-chain",
      "destination": "/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/pieces/marcus-thuram-infinity-chain",
      "destination": "/:lang/players/marcus-thuram",
      "statusCode": 301
    },
    {
      "source": "/players/jeff-chabot",
      "destination": "/players",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/players/jeff-chabot",
      "destination": "/:lang/players",
      "statusCode": 301
    },
    {
      "source": "/players/sidney-eweka",
      "destination": "/players",
      "statusCode": 301
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/players/sidney-eweka",
      "destination": "/:lang/players",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/view/:token",
      "destination": "/app.html"
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/view/:token",
      "destination": "/app.html"
    },
    {
      "source": "/vip/:token?",
      "destination": "/app.html"
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/vip/:token?",
      "destination": "/app.html"
    },
    {
      "source": "/:lang(fr|es|de|nl|ar)/:path*",
      "destination": "/:lang/404.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
