{
  "name": "berete-jewellers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/extensions/seo/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "prisma generate && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "db:migrate": "prisma migrate deploy",
    "import-media": "node scripts/import-media.mjs",
    "db:local": "node scripts/local-db.mjs",
    "lint": "eslint .",
    "verify": "playwright test",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "media:sizes": "node scripts/media-sizes.mjs",
    "verify:3d": "node scripts/verify-3d.mjs",
    "models:optimize": "tsx scripts/model-optimize.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "compression": "^1.8.1",
    "dotenv": "^18.0.5",
    "draco3dgltf": "^1.5.9",
    "express": "^5.2.1",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "^1.52.0",
    "meshoptimizer": "^1.3.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rhino3dm": "^8.35.0",
    "simple-icons": "15.22.0",
    "three": "^0.182.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.2"
  }
}
