# Copy to .env
DATABASE_URL="postgresql://berete@localhost:5433/berete"
PORT=3001
# Password of /admin (stories, players, pieces, boxes, messages)
ADMIN_PASSWORD="change-me"
# Optional: where the 3D models are kept (default: storage/ in the project)
# MODELS_DIR="/var/berete/storage"
# Optional: secret signing the client sessions and the addresses of the 3D files (default: a random value kept in the base)
# MODEL_SECRET=""

# The step « Imaginez votre création » of /contact (OpenAI Images, model gpt-image-1). Empty: the step is hidden.
OPENAI_API_KEY=
# low | medium | high | auto
OPENAI_IMAGE_QUALITY=medium
# Images for every visitor together, per 24 hours.
IMAGINE_DAILY_MAX=200

# The payments of The Private Atelier (Stripe): the payment stays hidden on the site while one of the three is missing.
# On the VPS: npm run vps -- set STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET STRIPE_PUBLISHABLE_KEY (values typed hidden).
# Webhook to declare at Stripe: https://beretejewellers.com/api/stripe/webhook (events checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
