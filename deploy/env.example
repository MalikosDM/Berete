# The settings of the site on the VPS: /srv/berete/.env (written by deploy/install.sh, never in git).
# Change one from the Mac: npm run vps -- set NAME=value  (the site restarts with it).

# The address of the site, without https:// (before the domain of the house: <IP with dashes>.sslip.io).
SITE_DOMAIN=beretejewellers.com
# off: closed to the search engines (noindex) until the launch; on: open.
SITE_INDEXING=off

# Password of /admin (made at the installation; npm run vps -- admin shows it).
ADMIN_PASSWORD=
# Password of the base (made at the installation, never typed).
POSTGRES_PASSWORD=

# Where the 3D files and the backups are kept on the VPS.
DATA_DIR=/srv/berete-data

# An e-mail to the house for every message and callback request of the site (the mailbox of the domain, one.com:
# send.one.com, port 465). Empty: the messages wait in the admin.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Who receives them (several addresses separated by commas).
ALERT_TO=
