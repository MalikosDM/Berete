generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// The site content. It starts from src/data/catalogue.ts (server/catalogue.ts)
/// and is edited from /admin. Media lists are MediaItem[] (src/data/types.ts).
/// seedHash: fingerprint of the texts last written from the catalogue; when the
/// texts in the base still match it, a new version of the catalogue replaces
/// them, otherwise they were edited from /admin and are kept.

model Story {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  cover      String   @default("")
  media      Json     @default("[]")
  people     String[] @default([])
  pieceSlug  String?
  articleUrl String?
  seedHash   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Person {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  kind      String   @default("player")
  number    Int?
  club      String?
  portrait  String?
  bio       String   @default("")
  seedHash  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Piece {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  type         String
  line         String   @default("")
  story        String   @default("")
  client       String?
  clientPublic Boolean  @default(false)
  cover        Json
  gallery      Json     @default("[]")
  handover     Json     @default("[]")
  specs        Json     @default("[]")
  press        Json     @default("[]")
  people       String[] @default([])
  boxSlug      String?
  featured     Boolean  @default(false)
  /// Provisional texts, to be checked with the client.
  draft        Boolean  @default(false)
  /// Photos or videos of the steps of "How it was made" (Making, src/data/types.ts).
  making       Json     @default("{}")
  seedHash     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Box {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  images      Json     @default("[]")
  pieceSlug   String?
  seedHash    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Files uploaded from /admin, served at /api/media/:id.
model MediaFile {
  id        String   @id @default(cuid())
  mime      String
  name      String?
  size      Int      @default(0)
  data      String
  createdAt DateTime @default(now())
}

/// Default entries already written once: an entry deleted from /admin is not written again.
model SeededEntry {
  key       String   @id
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model CallbackRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  interest  String?
  createdAt DateTime @default(now())
}
