generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// The site content. It starts from src/data/catalogue.ts (server/catalogue.ts)
/// and is edited from /admin. Media lists are MediaItem[] (src/data/types.ts).
/// seedHash: fingerprint of the texts last written from the catalogue; when the
/// texts in the base still match it, a new version of the catalogue replaces
/// them, otherwise they were edited from /admin and are kept.
/// translations: texts written in /admin for the other languages of the site,
/// { "fr": { "title": "..." }, "ar": {...} } (Translations, src/data/types.ts).

model Story {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  cover        String   @default("")
  media        Json     @default("[]")
  people       String[] @default([])
  pieceSlug    String?
  articleUrl   String?
  translations Json     @default("{}")
  seedHash     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Person {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  kind         String   @default("player")
  number       Int?
  club         String?
  portrait     String?
  /// Instagram username, without the @.
  instagram    String?
  bio          String   @default("")
  translations Json     @default("{}")
  seedHash     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Piece {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  type         String
  line         String   @default("")
  story        String   @default("")
  client       String?
  clientPublic Boolean  @default(false)
  cover        Json
  gallery      Json     @default("[]")
  handover     Json     @default("[]")
  specs        Json     @default("[]")
  /// The symbols of the piece, one by one ("The details": Detail, src/data/types.ts).
  details      Json     @default("[]")
  press        Json     @default("[]")
  people       String[] @default([])
  boxSlug      String?
  featured     Boolean  @default(false)
  /// Provisional texts, to be checked with the client.
  draft        Boolean  @default(false)
  /// Shown on the site. Unpublished: kept here (the admin can publish it again), shown nowhere on the site.
  published    Boolean  @default(true)
  /// The universe of its page (PieceTheme, src/data/themes.ts); null: the universe of the house.
  theme        Json?
  /// How its opening shows the jewel (PieceShowcase, src/data/showcase.ts): one view, the showcase, the views; null: by the rule.
  showcase     Json?
  /// Its atelier (PieceAtelier, src/data/atelier.ts): the making-of and the finished piece played full screen; null: its own.
  atelier      Json?
  /// "The Art of Detail" in 3D (PieceDetailPoints, src/data/details3d.ts): the points of its model tied to its details.
  detailPoints Json?
  /// The text of each photo of "Every Angle" (PieceAngles, src/data/angles.ts), by its address; a photo without one takes the catalogue's.
  angles       Json     @default("{}")
  /// Photos or videos of the steps of "How it was made" (Making, src/data/types.ts).
  making       Json     @default("{}")
  translations Json     @default("{}")
  seedHash     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Box {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @default("")
  images       Json     @default("[]")
  pieceSlug    String?
  /// Shown on the site (an unpublished box is kept for the admin, shown nowhere).
  published    Boolean  @default(true)
  translations Json     @default("{}")
  seedHash     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The personal photos of Yoni on the page The House, one per place ("portrait", "citation-1", "chapitre-03"...:
/// src/data/house.ts). photo: MediaItem (src/data/types.ts).
model HousePhoto {
  key       String   @id
  photo     Json
  updatedAt DateTime @updatedAt
}

/// Files uploaded from /admin, served at /api/media/:id.
model MediaFile {
  id        String   @id @default(cuid())
  mime      String
  name      String?
  size      Int      @default(0)
  data      String
  createdAt DateTime @default(now())
}

/// Default entries already written once: an entry deleted from /admin is not written again.
model SeededEntry {
  key       String   @id
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String         @id @default(cuid())
  name      String
  email     String
  /// Its Instagram handle, without "@" (optional).
  instagram String?
  message   String
  /// The language of the page it was sent from (en, fr, es, de, nl, ar): answer in it.
  language  String         @default("en")
  photos    ContactPhoto[]
  createdAt DateTime       @default(now())
}

/// A photo sent with a message (up to 6, made lighter in the browser first). Never public: the admin reads it
/// (GET /api/admin/messages/:id/photos/:photoId, behind the password), the e-mail of the house carries it.
model ContactPhoto {
  id        String         @id @default(cuid())
  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Its place among the photos of the message (0 = the first).
  position  Int
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime       @default(now())

  @@index([messageId])
}

model CallbackRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  interest  String?
  /// The language of the page it was sent from (en, fr, es, de, nl, ar): answer in it.
  language  String   @default("en")
  createdAt DateTime @default(now())
}

/// A 3D model of a jewel (admin "3D"). Its files live in the model storage
/// (server/models/storage.ts): the original as sent, full.glb (computers),
/// light.glb (phones), poster.webp (still image of the saved view).
/// status: queued, processing, ready, failed. sizes: bytes { original, full, light }.
/// stats: ModelStats, layers: LayerInfo[] (server/models/pipeline/index.ts).
/// settings: ModelSettings (src/data/models.ts): role of each layer, metals, view.
model Model3D {
  id         String          @id @default(cuid())
  name       String
  sourceName String
  sourceKind String
  status     String          @default("queued")
  progress   Int             @default(0)
  step       String          @default("")
  error      String?
  sizes      Json            @default("{}")
  stats      Json            @default("{}")
  layers     Json            @default("[]")
  settings   Json            @default("{}")
  hasPoster  Boolean         @default(false)
  /// The piece whose page shows this model ("Explore in 3D").
  pieceSlug  String?
  links      ViewLink[]
  clients    ClientModel[]
  shares     SealedShare[]
  versions   DesignVersion[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

/// A private link sent to a client instead of a link to another viewer: /view/<token>.
/// The token is random (24 bytes); the password, if any, is stored hashed (scrypt).
model ViewLink {
  id           String    @id @default(cuid())
  token        String    @unique
  modelId      String
  model        Model3D   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  title        String    @default("")
  expiresAt    DateTime?
  passwordHash String?
  createdAt    DateTime  @default(now())
}

/// A share link sealed on the admin's device (/s/<token>, server/routes/shares.ts): the model is encrypted in the browser
/// (AES-256-GCM), with a key derived from an optional password (PBKDF2-SHA-256) or a random key carried only in the
/// #fragment of the link. The server keeps the ciphertext (storage/shares/<token>.bin) and what the page needs to decrypt
/// it (salt, iv, iterations, a small verifier), never the key nor the password. Its file goes when it expires; the row is
/// kept 30 days more, so the page can say "expired".
model SealedShare {
  id          String   @id @default(cuid())
  token       String   @unique
  modelId     String
  model       Model3D  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  hasPassword Boolean  @default(false)
  salt        String   @default("")
  iv          String
  iterations  Int      @default(0)
  verifier    String
  bytes       Int
  createdAt   DateTime @default(now())

  @@index([modelId])
  @@index([expiresAt])
}

/// The role last given to a layer name in /admin (LayerSetting, src/data/models.ts):
/// a new model whose layers have the same names gets the same roles.
model LayerMemory {
  name      String   @id
  setting   Json
  updatedAt DateTime @updatedAt
}

/// A client of the jeweller with a private space on the site (/vip): the 3D
/// models he was given, and the follow-up of his commission (Yoni, 24/11/2026:
/// like a parcel tracking): the step of his piece, its estimated date, the news
/// of the atelier. He enters with his personal link (/vip/<token>) or with his
/// access code; the code is kept only as a keyed fingerprint (codeKey).
model Client {
  id            String             @id @default(cuid())
  name          String
  email         String?
  phone         String?
  token         String             @unique
  codeKey       String             @unique
  lastSeenAt    DateTime?
  /// The step of his piece among the six of "The Bespoke Journey" (0 The Private Consultation … 5 Final Payment &
  /// Presentation); 6: every step done, the piece handed over.
  stage         Int                @default(0)
  /// The day his piece should be finished (a day, no time), null while not said.
  estimatedAt   DateTime?          @db.Date
  models        ClientModel[]
  dateChanges   ClientDateChange[]
  updates       ClientUpdate[]
  createdAt     DateTime           @default(now())
  /// The Private Atelier (27/11/2026): his access created from his invitation (the e-mail he signs in with, lower case; his
  /// password as a fingerprint), his second factor ("" none, "email" a code by e-mail, "totp" an authenticator app, its secret
  /// sealed with the secret of the server), his access open or cut by Berete.
  loginEmail    String?            @unique
  passwordHash  String?
  activatedAt   DateTime?
  twoFactor     String             @default("")
  totpSecret    String?
  totpPending   String?
  totpLastStep  Int?
  accessEnabled Boolean            @default(true)
  invites       ClientInvite[]
  sessions      ClientSession[]
  codes         ClientCode[]
  projects      Project[]
}

/// Each change of the estimated date of a client (the old date, the new one, when): the client sees the last one.
model ClientDateChange {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  previous  DateTime? @db.Date
  next      DateTime? @db.Date
  createdAt DateTime  @default(now())

  @@index([clientId])
}

/// A news of the atelier for one client: a short note and its photos or videos, on a day.
model ClientUpdate {
  id        String             @id @default(cuid())
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note      String             @default("")
  /// The day of the news (today when sent, or the day chosen in the admin).
  date      DateTime           @db.Date
  files     ClientUpdateFile[]
  createdAt DateTime           @default(now())
  /// The journal of a project of The Private Atelier (27/11/2026): its project, and a draft until Berete publishes it.
  projectId String?
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draft     Boolean            @default(false)

  @@index([clientId])
  @@index([projectId])
}

/// A photo or a video of a news. The file lives in the storage (server/models/storage.ts, clientFiles):
/// storage/vip/<client id>/<file id>.<ext>, served only to that client (his session) or to the admin.
model ClientUpdateFile {
  id        String       @id @default(cuid())
  updateId  String
  update    ClientUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  /// Its place among the files of the news (0 = the first).
  position  Int
  /// "image" or "video".
  kind      String
  mime      String
  ext       String
  name      String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime     @default(now())

  @@index([updateId])
}

/// Which models a client sees in his space.
model ClientModel {
  clientId  String
  modelId   String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  model     Model3D  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([clientId, modelId])
}

/// Values of the server kept in the base (the secret signing sessions and file addresses).
model ServerSetting {
  key   String @id
  value String
}

/**
 * ---------- The Private Atelier (Yoni, 27/11/2026): the client's private space for real commissions ----------
 */

/// An invitation sent by Berete from the admin: a link used once, that expires (7 days by default). Only the fingerprint of
/// its token is kept (the token is in the e-mail and nowhere else).
model ClientInvite {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenKey  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

/// A session of a client on a device (revocable from the admin or by the client): the cookie carries its id, signed.
model ClientSession {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ip         String    @default("")
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([clientId])
}

/// A one-time code or link sent by e-mail: the second factor of a sign-in ("2fa"), a sign-in link ("magic"). Kept as a keyed
/// fingerprint; 5 tries at most; 10 minutes (codes) or 15 minutes (links).
model ClientCode {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purpose   String
  codeKey   String    @unique
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

/// The log of the sign-ins: who (or which e-mail), what (signin, signin-failed, code-failed, signout, invite-used, magic,
/// session-revoked, access-cut…), from where.
model ClientLogin {
  id        String   @id @default(cuid())
  clientId  String?
  email     String   @default("")
  event     String
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

/// A commission of a client: its design versions, its quotations, its payments, its making, its journal, its messages.
model Project {
  id              String           @id @default(cuid())
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  /// The currency of the project: "EUR" (Yoni's quotations), a field for later.
  currency        String           @default("EUR")
  /// The professional design fee already paid at the start (1 000 € by default), deducted from the final price; its day and
  /// its means (written by Berete).
  designFeeCents  Int              @default(100000)
  designFeePaidAt DateTime?        @db.Date
  designFeeMethod String           @default("")
  /// The metals and stones Berete allows the client to preview on his design (keys of METALS / stone colours).
  allowedMetals   Json             @default("[]")
  allowedStones   Json             @default("[]")
  /// The step of its making among the ten of the journey (0 Design Approved … 9 Delivered); -1 before the order.
  step            Int              @default(-1)
  /// The estimated delivery: a day or a window, shown only when Berete writes it.
  deliveryFrom    DateTime?        @db.Date
  deliveryTo      DateTime?        @db.Date
  /// Berete accepted the order (then the making may start once the funds are confirmed).
  orderAcceptedAt DateTime?
  productionAt    DateTime?
  archivedAt      DateTime?
  versions        DesignVersion[]
  changeRequests  ChangeRequest[]
  approvals       DesignApproval[]
  quotes          Quote[]
  payments        Payment[]
  steps           ProjectStep[]
  messages        ProjectMessage[]
  events          ProjectEvent[]
  updates         ClientUpdate[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([clientId])
}

/// A version of the 3D design: « Design v3 — 12 Dec 2026 », with what changed; a draft until Berete publishes it.
model DesignVersion {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  modelId     String?
  model       Model3D?         @relation(fields: [modelId], references: [id], onDelete: SetNull)
  changes     String           @default("")
  publishedAt DateTime?
  approvals   DesignApproval[]
  requests    ChangeRequest[]
  createdAt   DateTime         @default(now())

  @@unique([projectId, number])
}

/// A change asked by the client on a version: his words and, if he placed it, a point on the 3D (x, y, z of the model).
model ChangeRequest {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId String
  version   DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  comment   String
  point     Json?
  createdAt DateTime      @default(now())

  @@index([projectId])
}

/// The client approved a version as his final design: when, from which account, address and device.
model DesignApproval {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId String
  version   DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  clientId  String
  email     String        @default("")
  ip        String        @default("")
  userAgent String        @default("")
  createdAt DateTime      @default(now())

  @@index([projectId])
}

/// A quotation: the version it prices, the materials agreed, the price and its fees, the lead time, the schedule, Berete's
/// commercial terms as they were when sent. Draft → sent (frozen as a PDF and its SHA-256) → accepted, or superseded by a newer one.
model Quote {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number        Int
  versionId     String?
  status        String    @default("draft")
  materials     String    @default("")
  priceCents    Int       @default(0)
  feesCents     Int       @default(0)
  feesLabel     String    @default("")
  leadTime      String    @default("")
  schedule      String    @default("")
  terms         String    @default("")
  pdfSha256     String?
  sentAt        DateTime?
  acceptedAt    DateTime?
  acceptedEmail String    @default("")
  acceptedIp    String    @default("")
  acceptedUa    String    @default("")
  supersededAt  DateTime?
  payments      Payment[]
  createdAt     DateTime  @default(now())

  @@unique([projectId, number])
}

/// A payment of a project, by Stripe (hosted page): its share (deposit = 50 %, full = everything left, balance = the rest), the
/// amount computed by the server, its state, confirmed only by the signed notification of Stripe; its receipt (PDF).
model Payment {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteId       String
  quote         Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind          String
  amountCents   Int
  currency      String    @default("EUR")
  status        String    @default("pending")
  stripeSession String?   @unique
  stripeIntent  String?
  method        String    @default("")
  paidAt        DateTime?
  receiptNumber String?   @unique
  receiptSha256 String?
  createdAt     DateTime  @default(now())

  @@index([projectId])
}

/// Each notification of Stripe processed once (its id), whatever the number of times it comes.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// A step of the making (0 Design Approved … 9 Delivered): its state and its last update.
model ProjectStep {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  step      Int
  state     String   @default("pending")
  note      String   @default("")
  updatedAt DateTime @updatedAt

  @@id([projectId, step])
}

/// A message of a project, from the client or from Berete, with its attachments (photos, PDF).
model ProjectMessage {
  id        String               @id @default(cuid())
  projectId String
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    String
  body      String               @default("")
  readAt    DateTime?
  files     ProjectMessageFile[]
  createdAt DateTime             @default(now())

  @@index([projectId])
}

model ProjectMessageFile {
  id        String         @id @default(cuid())
  messageId String
  message   ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind      String
  mime      String
  ext       String
  name      String
  size      Int
  createdAt DateTime       @default(now())

  @@index([messageId])
}

/// The decisions and the history of a project (design approved, quotation sent / accepted / superseded, payment confirmed,
/// order accepted, step reached…), shown in its messages at their date; and the log of who did what (actor).
model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  actor     String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Who did what in the admin and in the client spaces, and when (the journal of Berete).
model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String   @default("")
  data      Json     @default("{}")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// The e-mails the site sends (invitations, codes, notifications, receipts): kept when there is no mailbox (development:
/// the e-mail is "caught" here), and as a trace once sent.
model OutboxEmail {
  id        String    @id @default(cuid())
  to        String
  subject   String
  text      String
  kind      String    @default("")
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

/**
 * ---------- The AI Creation Studio (Phase 2, 27/11/2026): « Create your own piece » ----------
 */

/// A studio of a visitor, without an account: reached again by its private link (only the fingerprint of its token is kept)
/// or sent by e-mail. Its concepts, the references he gave, his requests to Berete.
model AiStudio {
  id         String        @id @default(cuid())
  tokenKey   String        @unique
  email      String?
  concepts   AiConcept[]
  references AiReference[]
  requests   AiRequest[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

/// A concept made by the AI (an inspiration, never a piece of Berete): its words, its variation, kept or not, its cost.
model AiConcept {
  id         String   @id @default(cuid())
  studioId   String
  studio     AiStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  prompt     String
  variant    String   @default("")
  ext        String   @default("jpg")
  kept       Boolean  @default(false)
  costCents  Int      @default(0)
  model      String   @default("")
  visitorKey String   @default("")
  createdAt  DateTime @default(now())

  @@index([studioId])
  @@index([createdAt])
  @@index([visitorKey, createdAt])
}

/// A photo of inspiration given by the visitor.
model AiReference {
  id        String   @id @default(cuid())
  studioId  String
  studio    AiStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  ext       String
  size      Int
  createdAt DateTime @default(now())

  @@index([studioId])
}

/// A request of consultation sent from the studio, with its concepts and references: it may become a client and his project
/// in one click (clientId, projectId).
model AiRequest {
  id           String   @id @default(cuid())
  studioId     String
  studio       AiStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String   @default("")
  message      String   @default("")
  conceptIds   Json     @default("[]")
  referenceIds Json     @default("[]")
  status       String   @default("new")
  clientId     String?
  projectId    String?
  language     String   @default("en")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
